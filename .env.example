# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/army_of_salvation?retryWrites=true&w=majority

# Cloudinary Credentials for Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Base App URL for QR Code profile links (Set this to your live deployed domain URL)
# Example: NEXT_PUBLIC_APP_URL=https://army-of-salvation.vercel.app
NEXT_PUBLIC_APP_URL=https://your-live-domain.com
